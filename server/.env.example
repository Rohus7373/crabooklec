# Base de datos (opcional: si no se define, se usa localhost / root / sin clave / db-crabook)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db-crabook

# Impresora térmica de boletas
# IMPRESORA_TIPO=local        (USB / puerto compartido)  o  red
# IMPRESORA_DESTINO=...       (si es local: el nombre/puerto de la impresora)
# IMPRESORA_HOST=...          (si es red: la IP)
# IMPRESORA_PUERTO=9100
# IMPRESORA_CODEPAGE=2
# IMPRESORA_SIN_TILDES=false

# Login (opcional)
# AUTH_SECRET=una-frase-larga-y-secreta   (firma las sesiones; si no la defines se crea sola en server/.auth-secret)
# COOKIE_SEGURA=true                      (solo si algún día usas la app con https)
